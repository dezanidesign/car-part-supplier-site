# ============================================================================
# FDL Bespoke - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# ============================================================================
# WOOCOMMERCE API (Required)
# ============================================================================
# Get these from: WooCommerce → Settings → Advanced → REST API
NEXT_PUBLIC_WOOCOMMERCE_URL=https://wp.fdlbespoke.co.uk
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here
# Optional server-side aliases also supported by the admin product manager:
# WOOCOMMERCE_URL=https://wp.fdlbespoke.co.uk
# WORDPRESS_URL=https://wp.fdlbespoke.co.uk
# WP_URL=https://wp.fdlbespoke.co.uk
# WC_CONSUMER_KEY=ck_your_consumer_key_here
# WC_CONSUMER_SECRET=cs_your_consumer_secret_here

# ============================================================================
# PUBLIC URLS
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://www.fdlbespoke.co.uk
NEXT_PUBLIC_WP_URL=https://wp.fdlbespoke.co.uk

# ============================================================================
# STRIPE (Optional - for integrated payments)
# ============================================================================
# Get these from: Stripe Dashboard → Developers → API Keys
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# DATABASE (Required for Blog)
# ============================================================================
# Vercel Postgres or Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host/dbname?sslmode=require

# ============================================================================
# ADMIN AUTH (Required for Blog)
# ============================================================================
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-random-secret
ADMIN_EMAIL=Fdlbespokeuk@gmail.com
# Generate hash: node -e "require('bcryptjs').hash('your-password',12).then(h=>console.log(h))"
# Escape bcrypt '$' characters in local .env files so Next doesn't expand them away.
ADMIN_PASSWORD_HASH=\$2a\$12\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# VERCEL BLOB (Required for Blog Image Uploads)
# ============================================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
